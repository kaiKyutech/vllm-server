# cp .env.example .env
# 外部公開時の API キー。クライアントは Authorization: Bearer ... を送る。
# VLLM_API_KEY=ここに自分のキーを設定
# HF_TOKEN=必要なモデルの取得時のみ設定

# 保存先を変える場合のみ指定。全て絶対パスを使う。
# HF_HOME=/path/to/hf-metadata-cache
# VLLM_CACHE_ROOT=/path/to/compile-cache
# TRITON_CACHE_DIR=/path/to/triton-cache
# UV_PROJECT_ENVIRONMENT=/path/to/venv
# モデルフォルダを別名にした場合等、生成既定値JSONを明示する。
# GENERATION_DEFAULTS_FILE=/absolute/path/to/configs/generation/Qwen3.5-9B.json
